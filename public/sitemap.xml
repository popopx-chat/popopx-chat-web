<!--
  POPOPX main portal sitemap.

  Nine indexed routes: the seven in `ROUTES` (`src/lib/site.ts`, one
  `out/<route>/index.html` each) plus the two legal pages, which are linked from
  the footer rather than the navbar. Paths carry the trailing slash because
  `next.config.mjs` sets `trailingSlash: true` — without it the URL costs a
  redirect. The 21 languages are switched client-side from `localStorage`, not
  by URL, so there are no per-language entries and no `hreflang` alternates
  here: listing them would point crawlers at addresses the export does not
  produce.

  The built `/i/v1/` document is deliberately absent: it is an invitation bridge
  with `robots: { index: false }` and a `Disallow` line in robots.txt, not
  content. `tools/check-links.mjs` asserts that this set equals the built
  documents minus `404.html` and that one exemption, so a new route that is not
  listed here still fails the build gate.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://popopx.chat/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
